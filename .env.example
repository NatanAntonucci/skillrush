# Copie para `.env.local` e preencha com os dados do projeto Supabase.
# `.env.local` nunca é versionado.

# Público — vai no bundle do navegador (protegido por RLS).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Segredo — usado apenas por `npm run sync` (script local / GitHub Action).
# Nunca importe este valor em código de cliente.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Endereço público do site (sitemap, canonical, OG).
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# "true" em builds de staging: adiciona noindex e impede o Google de indexar.
NEXT_PUBLIC_NOINDEX=false
